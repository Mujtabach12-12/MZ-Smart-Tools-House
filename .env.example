VITE_SITE_URL=https://mztoolshouse.com
VITE_APP_NAME=MZ Smart Tool House
# Browser-safe base URL. For Netlify, use /api or leave blank and configure the AI client to use /api/ai.
VITE_API_BASE_URL=/api
VITE_AI_PROVIDER=
OCR_ENABLED=true

# SERVER-ONLY — do NOT prefix these with VITE_. Configure them in Netlify Environment Variables.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# Optional compiler gateway URL, e.g. https://compiler.example.com/api
# The frontend only enables native languages reported by GET <URL>/status.
# Never point this at the main web app unless that endpoint forwards to an isolated execution service.
VITE_COMPILER_API_URL=

# Optional dictionary provider override. Leave blank to use the same-origin Netlify dictionary gateway in production and the public provider in local development.
VITE_DICTIONARY_API_URL=
