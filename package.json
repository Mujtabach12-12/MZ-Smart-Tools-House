    "test:office-platform": "node test/office-platform.test.mjs",
    "test:seo-architecture": "node test/seo-architecture.test.mjs",
    "test:compiler-service": "node test/compiler-service.test.mjs",
    "test:compiler-matrix": "node test/compiler-backend-matrix.mjs",
    "test:final-platform": "node test/final-platform.test.mjs",
    "test:production-master": "node test/production-master.test.mjs",
    "verify:deps": "node scripts/verify-installed-deps.mjs",
    "predev": "npm run verify:deps",
    "test:dependency-safety": "node test/dependency-safety.test.mjs",
    "test:converters": "node test/converters.test.mjs",
    "test:science": "node test/science-formulas.test.mjs",
    "test:warning-fixes": "node test/warning-fixes.test.mjs",
    "test:mobile-ui": "node test/mobile-ui.test.mjs",
    "test:quality": "node test/quality-architecture.test.mjs",
